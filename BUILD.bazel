load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# The LIBFN_VERSION macro header; carried by both libraries.
cc_library(
    name = "version",
    hdrs = ["include/libfn_version.hpp"],
    includes = ["include"],
)

# C++20-compatible polyfills; always available.
cc_library(
    name = "pfn",
    hdrs = glob(["include/pfn/**/*.hpp"]),
    includes = ["include"],
    deps = [":version"],
)

# The functional library (C++20); built on the pfn polyfills.
cc_library(
    name = "fn",
    hdrs = glob(["include/fn/**/*.hpp"]),
    includes = ["include"],
    deps = [
        ":pfn",
        ":version",
    ],
)
