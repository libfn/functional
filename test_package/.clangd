# Compile flag relative paths resolve from the source file's CWD, which is `test_package/src`.
# Hence ../../include rather than ../include, as the location of this .clangd might imply.
CompileFlags:
  Add: [-std=c++20, -Wall, -Wextra, -Wpedantic, -Wno-missing-braces, -Wno-c2y-extensions, -isystem../../include]
  Remove: -W*
  Compiler: clang++
  CompilationDatabase: None
Diagnostics:
  ClangTidy:
    # This is play code. Remove what the root .clangd's Adds inherited here.
    Add: [bugprone*, readability*]
    Remove: [modernize*, performance*, readability-static-accessed-through-instance, readability-magic-numbers, readability-identifier-length]
