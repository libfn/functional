load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

cc_binary(
    name = "main",
    # The consumer-side suppression README.md documents: Bazel cannot receive
    # compile options from a dependency, and main.cpp constructs fn::pack.
    copts = ["-Wno-missing-braces"],
    srcs = ["src/main.cpp"],
    deps = [
        "@libfn//:fn",
        "@libfn//:pfn",
    ],
)
