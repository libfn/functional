load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

cc_binary(
    name = "main",
    # Warnings-as-errors, so CI fails when consuming libfn stops being warning-clean.
    # -Wno-missing-braces is the consumer-side suppression README.md documents: Bazel
    # cannot receive compile options from a dependency, and main.cpp constructs fn::pack.
    copts = [
        "-Wall",
        "-Werror",
        "-Wno-missing-braces",
    ],
    srcs = ["src/main.cpp"],
    deps = [
        "@libfn//:fn",
        "@libfn//:pfn",
    ],
)

cc_binary(
    name = "main_cxx26",
    # LIBFN_CXX26 propagates from the dep; the standard does not — Bazel has no
    # per-target language-level knob, so the C++26 flag is spelled here.
    copts = [
        "-std=c++26",
        "-Wall",
        "-Werror",
        "-Wno-missing-braces",
    ],
    srcs = ["src/main.cpp"],
    deps = [
        "@libfn//:fn_cxx26",
    ],
)
